{
  "dangerouslySkipPermissions": ["Read", "Grep", "Glob", "Bash", "Write", "Edit", "TodoWrite"],
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/.enable-hooks ] && afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/.enable-hooks ] && afplay /System/Library/Sounds/Submarine.aiff"
          }
        ]
      }
    ]
  }
}
